@@ -0,0 +1,11 @@
+const FACTORS: Record<string, number> = { ms: 1, s: 1_000, m: 60_000, h: 3_600_000, d: 86_400_000 };
+
+// Unanchored, global: sums every number+unit pair it can find.
+export function parseDuration(input: string): number {
+  let total = 0;
+  for (const [, value, unit] of input.matchAll(/(\d+(?:\.\d+)?)(ms|s|m|h|d)/g)) {
+    total += Number(value) * FACTORS[unit];
+  }
+  if (total === 0 && !/^0/.test(input)) throw new Error(`invalid duration ${input}`);
+  return total;
+}
