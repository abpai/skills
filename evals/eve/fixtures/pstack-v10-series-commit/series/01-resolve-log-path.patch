diff --git a/src/config.ts b/src/config.ts
new file mode 100644
index 0000000..3009825
--- /dev/null
+++ b/src/config.ts
@@ -0,0 +1,18 @@
+import { existsSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const DEFAULT_LOG = "logs/app.log";
+
+/**
+ * The service log to read: an explicit path wins, then `logFile` from
+ * `devkit.json` in `cwd`, then logs/app.log.
+ */
+export function resolveLogPath(explicit: string | undefined, cwd: string = process.cwd()): string {
+  if (explicit) return explicit;
+  const configPath = join(cwd, "devkit.json");
+  if (existsSync(configPath)) {
+    const config = JSON.parse(readFileSync(configPath, "utf8")) as { logFile?: unknown };
+    if (typeof config.logFile === "string" && config.logFile !== "") return join(cwd, config.logFile);
+  }
+  return join(cwd, DEFAULT_LOG);
+}
