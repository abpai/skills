--- /dev/null
+++ b/tests/config.test.ts
@@ -0,0 +1,20 @@
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, test } from "bun:test";
+import { resolveLogPath } from "../src/config";
+
+test("an explicit path wins", () => {
+  expect(resolveLogPath("x.log", "/nowhere")).toBe("x.log");
+});
+
+test("reads logFile from devkit.json", () => {
+  const dir = mkdtempSync(join(tmpdir(), "devkit-cfg-"));
+  writeFileSync(join(dir, "devkit.json"), JSON.stringify({ logFile: "var/api.log" }));
+  expect(resolveLogPath(undefined, dir)).toBe(join(dir, "var/api.log"));
+});
+
+test("falls back to logs/app.log", () => {
+  const dir = mkdtempSync(join(tmpdir(), "devkit-cfg-"));
+  expect(resolveLogPath(undefined, dir)).toBe(join(dir, "logs/app.log"));
+});
