diff --git a/tests/interval.test.ts b/tests/interval.test.ts
new file mode 100644
index 0000000..dd06a92
--- /dev/null
+++ b/tests/interval.test.ts
@@ -0,0 +1,13 @@
+import { expect, test } from "bun:test";
+import { parseInterval } from "../src/interval";
+
+test("parses milliseconds and seconds", () => {
+  expect(parseInterval("500ms")).toBe(500);
+  expect(parseInterval("2s")).toBe(2000);
+  expect(parseInterval("1.5s")).toBe(1500);
+});
+
+test("rejects malformed and too-small intervals", () => {
+  expect(() => parseInterval("fast")).toThrow("invalid interval");
+  expect(() => parseInterval("10ms")).toThrow("below the 50ms minimum");
+});
