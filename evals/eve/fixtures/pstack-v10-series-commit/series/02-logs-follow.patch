@@ -0,0 +1,22 @@
+import { appendFileSync } from "node:fs";
+import { expect, test } from "bun:test";
+import { runLogs } from "../src/logs";
+import { capture, tempLog } from "./helpers";
+
+test("logs --follow prints existing lines, then lines appended later", async () => {
+  const controller = new AbortController();
+  const io = capture(controller.signal);
+  const path = tempLog("GET /health 200\n");
+  const running = runLogs([path, "--follow"], io);
+  setTimeout(() => appendFileSync(path, "GET /orders 200\n"), 50);
+  setTimeout(() => controller.abort(), 700);
+  expect(await running).toBe(0);
+  expect(io.lines).toEqual(["GET /health 200", "GET /orders 200"]);
+});
+
+test("logs --follow rejects --grep", async () => {
+  const io = capture();
+  expect(await runLogs([tempLog("GET /health 200\n"), "--follow", "--grep", "GET"], io)).toBe(2);
+  expect(io.errors[0]).toContain("--follow does not support --grep");
+  expect(io.lines).toEqual([]);
+});
