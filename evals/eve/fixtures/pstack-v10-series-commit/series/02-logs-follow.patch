+++ b/src/symbols.ts
@@ -0,0 +1,129 @@
+import { readFileSync } from "node:fs";
+import type { Io } from "./io";
+
+/**
+ * Symbolicate a production stack trace against a source map (version 3), so a
+ * frame like `at r (app.min.js:1:9)` reads `at handleOrder (src/orders.ts:2:0)`.
+ */
+
+const BASE64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+export interface SourceMap {
+  version: number;
+  sources: string[];
+  names?: string[];
+  mappings: string;
+}
+
+/** One mapped segment, with every field already made absolute. */
+export interface Segment {
+  generatedColumn: number;
+  source: number;
+  originalLine: number;
+  originalColumn: number;
+  name?: number;
+}
+
+export interface OriginalPosition {
+  source: string;
+  line: number;
+  column: number;
+  name?: string;
+}
+
+/** Decode one base64 VLQ segment into its signed integers. */
+export function decodeVlq(segment: string): number[] {
+  const values: number[] = [];
+  let value = 0;
+  let shift = 0;
+  for (const char of segment) {
+    const digit = BASE64.indexOf(char);
+    if (digit < 0) throw new Error(`invalid VLQ character "${char}"`);
+    value += (digit & 31) << shift;
+    if (digit & 32) {
+      shift += 5;
+      continue;
+    }
+    values.push(value & 1 ? -(value >> 1) : value >> 1);
+    value = 0;
+    shift = 0;
+  }
+  if (shift !== 0) throw new Error(`truncated VLQ segment "${segment}"`);
+  return values;
+}
+
+/** Expand the `mappings` string into absolute segments per generated line. */
+export function parseMappings(mappings: string): Segment[][] {
+  const lines: Segment[][] = [];
+  let source = 0;
+  let originalLine = 0;
+  let originalColumn = 0;
+  let name = 0;
+  for (const line of mappings.split(";")) {
+    const segments: Segment[] = [];
+    let generatedColumn = 0;
+    for (const raw of line.split(",")) {
+      if (raw === "") continue;
+      const fields = decodeVlq(raw);
+      generatedColumn += fields[0];
+      if (fields.length < 4) continue;
+      source += fields[1];
+      originalLine += fields[2];
+      originalColumn += fields[3];
+      const segment: Segment = { generatedColumn, source, originalLine, originalColumn };
+      if (fields.length >= 5) {
+        name += fields[4];
+        segment.name = name;
+      }
+      segments.push(segment);
+    }
+    lines.push(segments);
+  }
+  return lines;
+}
+
+/** Map a 1-based generated line and 0-based column back to original source. */
+export function originalPosition(map: SourceMap, line: number, column: number): OriginalPosition | undefined {
+  const segments = parseMappings(map.mappings)[line - 1] ?? [];
+  let best: Segment | undefined;
+  for (const segment of segments) {
+    if (segment.generatedColumn > column) break;
+    best = segment;
+  }
+  if (!best) return undefined;
+  return {
+    source: map.sources[best.source],
+    line: best.originalLine + 1,
+    column: best.originalColumn,
+    name: best.name === undefined ? undefined : map.names?.[best.name],
+  };
+}
+
+const FRAME = /^(\s*at\s+)(?:([^\s(]+)\s+\()?([^():\s]+):(\d+):(\d+)\)?\s*$/;
+
+/** Rewrite every mappable `at fn (file:line:col)` frame in a trace. */
+export function symbolicate(trace: string, map: SourceMap): string {
+  return trace
+    .split("\n")
+    .map((frame) => {
+      const match = FRAME.exec(frame);
+      if (!match) return frame;
+      const [, lead, fn, , line, column] = match;
+      const pos = originalPosition(map, Number(line), Number(column));
+      if (!pos) return frame;
+      return `${lead}${pos.name ?? fn ?? "<anonymous>"} (${pos.source}:${pos.line}:${pos.column})`;
+    })
+    .join("\n");
+}
+
+export async function runSymbols(args: readonly string[], io: Io): Promise<number> {
+  const [traceFile, mapFile] = args;
+  if (!traceFile || !mapFile) {
+    io.err("usage: devkit symbols <trace-file> <source-map>");
+    return 2;
+  }
+  const map = JSON.parse(readFileSync(mapFile, "utf8")) as SourceMap;
+  if (map.version !== 3) throw new Error(`unsupported source map version ${map.version}`);
+  for (const line of symbolicate(readFileSync(traceFile, "utf8"), map).split("\n")) io.out(line);
+  return 0;
+}
