new file mode 100644
index 0000000..f1ba06a
--- /dev/null
+++ b/tests/symbols.test.ts
@@ -0,0 +1,36 @@
+import { expect, test } from "bun:test";
+import { decodeVlq, originalPosition, parseMappings, symbolicate, type SourceMap } from "../src/symbols";
+
+// Generated line 1: col 0 -> orders.ts 1:0, col 9 -> orders.ts 1:9 named handleOrder.
+// Generated line 2: col 0 -> orders.ts 2:0.
+const MAP: SourceMap = {
+  version: 3,
+  sources: ["src/orders.ts"],
+  names: ["handleOrder"],
+  mappings: "AAAA,SAASA;AACT",
+};
+
+test("decodes VLQ segments", () => {
+  expect(decodeVlq("AAAA")).toEqual([0, 0, 0, 0]);
+  expect(decodeVlq("SAASA")).toEqual([9, 0, 0, 9, 0]);
+  expect(decodeVlq("D")).toEqual([-1]);
+  expect(decodeVlq("gB")).toEqual([16]);
+});
+
+test("makes segment fields absolute", () => {
+  const lines = parseMappings(MAP.mappings);
+  expect(lines[0][1]).toEqual({ generatedColumn: 9, source: 0, originalLine: 0, originalColumn: 9, name: 0 });
+  expect(lines[1][0]).toMatchObject({ generatedColumn: 0, originalLine: 1, originalColumn: 0 });
+});
+
+test("finds the original position", () => {
+  expect(originalPosition(MAP, 1, 12)).toEqual({ source: "src/orders.ts", line: 1, column: 9, name: "handleOrder" });
+  expect(originalPosition(MAP, 3, 0)).toBeUndefined();
+});
+
+test("rewrites mappable frames and keeps the rest", () => {
+  const trace = ["TypeError: x is undefined", "    at r (app.min.js:1:9)", "    at native code"].join("\n");
+  expect(symbolicate(trace, MAP)).toBe(
+    ["TypeError: x is undefined", "    at handleOrder (src/orders.ts:1:9)", "    at native code"].join("\n"),
+  );
+});
