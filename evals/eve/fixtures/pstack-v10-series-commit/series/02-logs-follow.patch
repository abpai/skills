+const MIN_INTERVAL_MS = 50;
+
+/** Parse a polling interval such as "500ms", "2s", or "1.5s" into milliseconds. */
+export function parseInterval(value: string): number {
+  const match = /^(\d+(?:\.\d+)?)(ms|s)$/.exec(value.trim());
+  if (!match) throw new Error(`invalid interval "${value}" (use e.g. 500ms or 2s)`);
+  const ms = match[2] === "s" ? Number(match[1]) * 1000 : Number(match[1]);
+  if (ms < MIN_INTERVAL_MS) throw new Error(`interval ${value} is below the ${MIN_INTERVAL_MS}ms minimum`);
+  return Math.round(ms);
+}
